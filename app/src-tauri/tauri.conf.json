{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VEditor",
  "version": "0.1.0",
  "identifier": "com.veditor.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:8560",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VEditor",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/**", "$TMPDIR/**", "/tmp/**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/32x32.png"],
    "category": "Video",
    "shortDescription": "VEditor - 开源剪映式视频编辑器",
    "longDescription": "VEditor 是基于 Rust/Tauri/FFmpeg 的开源桌面视频编辑器,支持多轨剪辑、关键帧动画、蒙版、混合模式、字幕/ASR、导出等。",
    "copyright": "Copyright © 2026 VEditor contributors",
    "linux": {
      "deb": {
        "depends": ["ffmpeg", "libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "desktopTemplate": "./deb/veditor.desktop"
      }
    }
  }
}
